# Server-only secrets. Never prefix these with VITE_ or expose them to the browser.
# The gateway uses an OpenAI-compatible /chat/completions endpoint; set the base URL
# and model for a compatible provider. Keep AI_API_KEY only in the server runtime.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Set true in production once a server-side JWT verifier is configured.
AI_REQUIRE_AUTH=false
# Per-user limits. Cache hits and idempotent retries do not consume daily quota.
AI_DAILY_QUOTA=20
AI_RATE_LIMIT=10
# Abort a provider request after this many milliseconds and return provider_timeout.
AI_TIMEOUT_MS=12000
AI_CACHE_TTL_MS=86400000
ALLOWED_ORIGIN=http://localhost:5173

# Browser-safe Supabase configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
