# Server-only secrets. Never prefix these with VITE_ or expose them to the browser.
# Cloudflare Worker /api/translate and /api/explain use an OpenAI-compatible
# /chat/completions endpoint. In Cloudflare, add AI_API_KEY as a Worker Secret;
# AI_PROVIDER, AI_BASE_URL, AI_MODEL, AI_RATE_LIMIT and AI_TIMEOUT_MS may be
# normal Worker variables. Keep AI_API_KEY only in the server runtime.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Production must explicitly use production mode and a verified identity. Do not
# treat an arbitrary Bearer string as verified: deploy the JWT verifier adapter first.
AI_ENV=development
AI_REQUIRE_AUTH=false
# Required whenever a staging/production AI or OCR gateway is enabled. This is
# the Supabase Auth JWT secret from the project's secure server settings, never a
# browser value. HS256 tokens only; do not prefix it with VITE_.
SUPABASE_JWT_SECRET=
# Optional but recommended exact claim checks. The issuer normally ends in
# /auth/v1 and the audience is normally authenticated.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Server-side URL and anon key used only to invoke the authenticated quota RPC.
# They are not provider secrets, but are intentionally separate from browser VITE_ values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Per-user limits. Cache hits and idempotent retries do not consume daily quota.
AI_DAILY_QUOTA=20
OCR_DAILY_QUOTA=20
AI_RATE_LIMIT=10
# Abort a provider request after this many milliseconds and return provider_timeout.
AI_TIMEOUT_MS=12000
AI_CACHE_TTL_MS=86400000
ALLOWED_ORIGIN=http://localhost:5173

# OCR is server-only too. mock is valid only for local development; production
# requires a real provider, production mode, a key and an HTTPS base URL.
OCR_PROVIDER=mock
OCR_ENV=development
OCR_REQUIRE_AUTH=false
OCR_BASE_URL=
OCR_API_KEY=
OCR_TIMEOUT_MS=20000

# Browser-safe Supabase configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Private cloud-library Worker gateway. This is a Cloudflare Worker Secret only;
# never use a VITE_ prefix or put a value in this checked-in example.
SUPABASE_SERVICE_ROLE_KEY=

# Deployment platform secrets are intentionally not listed with values here.
# Add VERCEL_TOKEN, VERCEL_ORG_ID and VERCEL_PROJECT_ID only to the matching
# GitHub staging/production environment, never to a browser build or this file.
