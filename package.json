{
  "name": "wor-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "qa": "node scripts/run-qa-agent.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "test:gateway": "node --test server/ai-gateway.test.mjs",
    "test:quality": "node --test scripts/quality-gate.test.mjs",
    "quality": "node scripts/quality-gate.mjs",
    "test:production": "npm run validate:env -- --production && npm run typecheck && npm run build && npm run test:gateway",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
